{
  parserClass="de.magynhard.crystal.parser.CrystalParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Crystal"
  psiImplClassSuffix="Impl"
  psiPackage="de.magynhard.crystal.psi"
  psiImplPackage="de.magynhard.crystal.psi.impl"

  elementTypeHolderClass="de.magynhard.crystal.psi.CrystalTypes"
  elementTypeClass="de.magynhard.crystal.psi.CrystalElementType"
  tokenTypeClass="de.magynhard.crystal.lexer.CrystalTokenType"
  elementTypeFactory("class_definition|module_definition|struct_definition|enum_definition|method_definition|macro_definition|lib_definition|annotation_definition|alias_definition")="de.magynhard.crystal.stubs.CrystalStubElementTypeFactory.create"

  parserImports=[
    "static de.magynhard.crystal.parser.CrystalParserPredicates.*"
  ]

  tokens = [
    // Keywords
    ABSTRACT="ABSTRACT"
    ALIAS="ALIAS"
    ANNOTATION="ANNOTATION"
    AS="AS"
    AS_QUESTION="AS_QUESTION"
    ASM="ASM"
    BEGIN="BEGIN"
    BREAK="BREAK"
    CASE="CASE"
    CLASS="CLASS"
    DEF="DEF"
    DO="DO"
    ELSE="ELSE"
    ELSIF="ELSIF"
    END="END"
    ENSURE="ENSURE"
    ENUM="ENUM"
    EXTEND="EXTEND"
    FALSE="FALSE"
    FOR="FOR"
    FORALL="FORALL"
    FUN="FUN"
    IF="IF"
    IN="IN"
    INCLUDE="INCLUDE"
    INSTANCE_SIZEOF="INSTANCE_SIZEOF"
    IS_A="IS_A"
    LIB="LIB"
    MACRO="MACRO"
    MODULE="MODULE"
    NEXT="NEXT"
    NIL="NIL"
    NIL_QUESTION="NIL_QUESTION"
    OF="OF"
    OFFSETOF="OFFSETOF"
    OUT="OUT"
    POINTEROF="POINTEROF"
    PREVIOUS_DEF="PREVIOUS_DEF"
    PRIVATE="PRIVATE"
    PROTECTED="PROTECTED"
    REQUIRE="REQUIRE"
    RESCUE="RESCUE"
    RESPONDS_TO="RESPONDS_TO"
    RETURN="RETURN"
    SELECT="SELECT"
    SELF="SELF"
    SIZEOF="SIZEOF"
    STRUCT="STRUCT"
    SUPER="SUPER"
    THEN="THEN"
    TRUE="TRUE"
    TYPEOF="TYPEOF"
    UNINITIALIZED="UNINITIALIZED"
    UNION="UNION"
    UNLESS="UNLESS"
    UNTIL="UNTIL"
    VERBATIM="VERBATIM"
    WHEN="WHEN"
    WHILE="WHILE"
    WITH="WITH"
    YIELD="YIELD"

    // Literals
    INTEGER_LITERAL="INTEGER_LITERAL"
    FLOAT_LITERAL="FLOAT_LITERAL"
    CHAR_LITERAL="CHAR_LITERAL"
    STRING_LITERAL="STRING_LITERAL"
    STRING_INTERPOLATION_BEGIN="STRING_INTERPOLATION_BEGIN"
    STRING_INTERPOLATION_END="STRING_INTERPOLATION_END"
    COMMAND_LITERAL="COMMAND_LITERAL"
    COMMAND_BEGIN="COMMAND_BEGIN"
    COMMAND_END="COMMAND_END"
    REGEX_LITERAL="REGEX_LITERAL"
    SYMBOL_LITERAL="SYMBOL_LITERAL"
    HEREDOC_START="HEREDOC_START"
    HEREDOC_CONTENT="HEREDOC_CONTENT"
    HEREDOC_END="HEREDOC_END"
    STRING_ESCAPE="STRING_ESCAPE"
    PERCENT_LITERAL_BEGIN="PERCENT_LITERAL_BEGIN"
    PERCENT_LITERAL_END="PERCENT_LITERAL_END"
    PERCENT_WORD_ARRAY_BEGIN="PERCENT_WORD_ARRAY_BEGIN"
    PERCENT_WORD_ARRAY_END="PERCENT_WORD_ARRAY_END"
    PERCENT_SYMBOL_BEGIN="PERCENT_SYMBOL_BEGIN"
    PERCENT_SYMBOL_END="PERCENT_SYMBOL_END"
    SYMBOL_COLON="SYMBOL_COLON"

    // Macro body tokens
    MACRO_BODY_CONTENT="MACRO_BODY_CONTENT"
    MACRO_FRESH_VAR="MACRO_FRESH_VAR"
    MACRO_INTERPOLATION_BEGIN="MACRO_INTERPOLATION_BEGIN"
    MACRO_INTERPOLATION_END="MACRO_INTERPOLATION_END"
    MACRO_CONTROL_BEGIN="MACRO_CONTROL_BEGIN"
    MACRO_CONTROL_END="MACRO_CONTROL_END"
    // Escaped macro forms: `\{% stmt %}` / `\{{ expr }}` carry a backslash
    // before the opening brace (Crystal treats it as verbatim data).
    MACRO_CONTROL_ESCAPED_BEGIN="MACRO_CONTROL_ESCAPED_BEGIN"
    MACRO_INTERPOLATION_ESCAPED_BEGIN="MACRO_INTERPOLATION_ESCAPED_BEGIN"

    // Identifiers
    IDENTIFIER="IDENTIFIER"
    CONSTANT="CONSTANT"
    INSTANCE_VAR="INSTANCE_VAR"
    CLASS_VAR="CLASS_VAR"
    GLOBAL_VAR="GLOBAL_VAR"

    // Operators
    PLUS="PLUS"
    MINUS="MINUS"
    STAR="STAR"
    SLASH="SLASH"
    DOUBLE_SLASH="DOUBLE_SLASH"
    PERCENT="PERCENT"
    AMPERSAND="AMPERSAND"
    PIPE="PIPE"
    CARET="CARET"
    TILDE="TILDE"
    DOUBLE_STAR="DOUBLE_STAR"
    WRAP_PLUS="WRAP_PLUS"
    WRAP_MINUS="WRAP_MINUS"
    WRAP_STAR="WRAP_STAR"
    WRAP_DOUBLE_STAR="WRAP_DOUBLE_STAR"
    LSHIFT="LSHIFT"
    RSHIFT="RSHIFT"
    EQ="EQ"
    NEQ="NEQ"
    LT="LT"
    GT="GT"
    LTE="LTE"
    GTE="GTE"
    SPACESHIP="SPACESHIP"
    CASE_EQ="CASE_EQ"
    MATCH_OP="MATCH_OP"
    BANG_TILDE="BANG_TILDE"
    BANG="BANG"
    AND_AND="AND_AND"
    OR_OR="OR_OR"
    ASSIGN="ASSIGN"
    PLUS_ASSIGN="PLUS_ASSIGN"
    MINUS_ASSIGN="MINUS_ASSIGN"
    STAR_ASSIGN="STAR_ASSIGN"
    SLASH_ASSIGN="SLASH_ASSIGN"
    PERCENT_ASSIGN="PERCENT_ASSIGN"
    AMPERSAND_ASSIGN="AMPERSAND_ASSIGN"
    PIPE_ASSIGN="PIPE_ASSIGN"
    CARET_ASSIGN="CARET_ASSIGN"
    DOUBLE_STAR_ASSIGN="DOUBLE_STAR_ASSIGN"
    WRAP_PLUS_ASSIGN="WRAP_PLUS_ASSIGN"
    WRAP_MINUS_ASSIGN="WRAP_MINUS_ASSIGN"
    WRAP_STAR_ASSIGN="WRAP_STAR_ASSIGN"
    WRAP_DOUBLE_STAR_ASSIGN="WRAP_DOUBLE_STAR_ASSIGN"
    DOUBLE_SLASH_ASSIGN="DOUBLE_SLASH_ASSIGN"
    LSHIFT_ASSIGN="LSHIFT_ASSIGN"
    RSHIFT_ASSIGN="RSHIFT_ASSIGN"
    OR_OR_ASSIGN="OR_OR_ASSIGN"
    AND_AND_ASSIGN="AND_AND_ASSIGN"
    DOT="DOT"
    DOTDOT="DOTDOT"
    DOTDOTDOT="DOTDOTDOT"
    ARROW="ARROW"
    DOUBLE_ARROW="DOUBLE_ARROW"
    QUESTION="QUESTION"
    COLON="COLON"
    DOUBLE_COLON="DOUBLE_COLON"
    SEMICOLON="SEMICOLON"
    COMMA="COMMA"
    HASH="HASH"
    AT="AT"

    // Delimiters
    LPAREN="LPAREN"
    RPAREN="RPAREN"
    LBRACKET="LBRACKET"
    RBRACKET="RBRACKET"
    LBRACE="LBRACE"
    RBRACE="RBRACE"

    // Whitespace & Comments
    LINE_COMMENT="LINE_COMMENT"
    NEWLINE="NEWLINE"
  ]
}

// ==================== Top Level ====================

crystalFile ::= top_level_statement*

private top_level_statement ::= NEWLINE
                              | SEMICOLON
                              | include_statement
                              | extend_statement
                              | annotation_usage
                              | class_definition
                              | module_definition
                              | struct_definition
                              | enum_definition
                              | lib_definition
                              | top_level_fun
                              | annotation_definition
                              | method_definition
                              | macro_definition
                              | alias_definition
                              | visibility_modifier
                              | macro_control
                              | macro_control_escaped
                              | macro_interpolation_escaped
                              | statement

// ==================== Require / Include / Extend ====================

require_statement ::= REQUIRE string_expression {pin=1}

include_statement ::= INCLUDE type_reference {pin=1}

extend_statement ::= EXTEND (type_reference | SELF) {pin=1}

// ==================== Type Definitions ====================

class_definition ::= [ABSTRACT] CLASS type_name [type_parameters] [superclass_clause] class_body END {
  pin(".*")=2
  stubClass="de.magynhard.crystal.stubs.CrystalClassDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedClassDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

superclass_clause ::= LT type_reference

module_definition ::= MODULE type_name [type_parameters] class_body END {
  pin=1
  stubClass="de.magynhard.crystal.stubs.CrystalModuleDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedModuleDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

struct_definition ::= [ABSTRACT] STRUCT type_name [type_parameters] [superclass_clause] class_body END {
  pin(".*")=2
  stubClass="de.magynhard.crystal.stubs.CrystalStructDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedStructDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

enum_definition ::= ENUM type_name [COLON type_reference] enum_body END {
  pin=1
  stubClass="de.magynhard.crystal.stubs.CrystalEnumDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedEnumDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

lib_definition ::= LIB CONSTANT lib_outer_body END {
  pin=1
  stubClass="de.magynhard.crystal.stubs.CrystalLibDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedLibDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

// The compiler's parse_annotation_def accepts any StatementEnd (semicolon,
// newline, or space) between the name and `end` (parser.cr StatementEnd),
// so `annotation Field; end` (uri/params/serializable.cr) is valid.
annotation_definition ::= ANNOTATION type_name (NEWLINE | SEMICOLON)* END {
  pin=1
  stubClass="de.magynhard.crystal.stubs.CrystalAnnotationDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedAnnotationDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

annotation_usage ::= AT LBRACKET type_path [LPAREN NLS argument_list NLS RPAREN] RBRACKET

alias_definition ::= ALIAS type_name ASSIGN type_reference {
  pin=1
  stubClass="de.magynhard.crystal.stubs.CrystalAliasDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedAliasDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

// ==================== Type Bodies ====================

// Class bodies accept nested `lib` definitions (`class ELF; lib LibELF ...; end`
// in crystal/system/unix/elf.cr and mach_o.cr). The compiler parses type bodies
// with full expression parsing and only forbids `lib` inside method bodies
// (parser.cr:1193-1198). LIB starts no other class member, so this alternative
// is PEG-safe next to the nested type definitions.
class_body ::= class_member*

private class_member ::= NEWLINE
                        | SEMICOLON
                        | annotation_usage
                        | annotation_definition
                        | method_definition
                        | macro_definition
                        | class_definition
                        | module_definition
                        | struct_definition
                        | enum_definition
                        | lib_definition
                        | include_statement
                        | extend_statement
                        | alias_definition
                        | visibility_modifier
                        | property_declaration
                        | macro_control
                        | macro_control_escaped
                        | macro_interpolation_escaped
                        | statement

enum_body ::= enum_member*

// Enum bodies accept macro forms (`{% if flag?(:arm) %} FAILURE = 9 {% end %}`
// in lib_unwind's ReasonCode); the compiler's parse_enum_body_expressions takes
// `{% %}`, `{{ }}` and `@[...]` (parser.cr:6360-6365) just like lib bodies.
// The !ASSIGN guard keeps `{{value.id}} = LibC::{{value.id}}` (errno.cr)
// flowing into enum_constant: without it PEG commits the bare interpolation
// member and strands the `=`.
private enum_member ::= NEWLINE | SEMICOLON | annotation_usage | macro_control | macro_control_escaped | macro_interpolation !ASSIGN | macro_interpolation_escaped | enum_constant | method_definition

enum_constant ::= (CONSTANT | macro_interpolation) [ASSIGN expression]

// Canonical PSI schema for lib-shaped bodies. The concrete outer-lib, struct,
// and union rules below all use this element type, preserving their shared
// CrystalLibBody accessors while constraining what each context admits.
lib_body ::= lib_member*

// Crystal allows constant assignments in lib bodies (`lib LibC { F_GETFD = 1 }`);
// the compiler's parse_lib_body_exp_without_location binds CONST + OP_EQ as a
// plain Assign (src/compiler/crystal/syntax/parser.cr:5891). The existing tight
// constant_assignment rule (CONSTANT ASSIGN) is PEG-unique among lib members
// (none of the other alternatives starts with CONSTANT).
// Annotations attach to lib members (`@[Flags] enum ...`, `@[Raises] fun ...`);
// the compiler's parse_lib_body_exp_without_location accepts `@[...]` via
// parse_annotation (src/compiler/crystal/syntax/parser.cr:5867-5870), so the
// existing annotation_usage rule joins lib_member exactly like class bodies.
// Macro forms generate lib members (`{% if flag?(:win32) %} ... {% end %}`
// headers, `{% if %} fun ... {% end %}` single-liners); the compiler's
// parse_lib_body_exp_without_location accepts both (parser.cr:5921-5924,
// parser_spec.cr:1330-1331), so macro_control and macro_interpolation join
// lib_member exactly like class bodies and statements.
private lib_member ::= NEWLINE | SEMICOLON | annotation_usage | macro_control | macro_control_escaped | macro_interpolation | macro_interpolation_escaped | constant_assignment | fun_definition | type_alias_lib | lib_type_alias | lib_struct_definition | lib_union_definition | enum_definition | lib_external_var | lib_field

// The outer lib, C struct, and C union accept different member subsets. Their
// shared element type keeps the established CrystalLibBody PSI contract.
lib_outer_body ::= lib_outer_member* {elementType=lib_body}
private lib_outer_member ::= NEWLINE | SEMICOLON | annotation_usage | macro_control | macro_control_escaped | macro_interpolation | macro_interpolation_escaped | constant_assignment | fun_definition | type_alias_lib | lib_type_alias | lib_struct_definition | lib_union_definition | enum_definition | lib_external_var
lib_struct_body ::= lib_struct_member* {elementType=lib_body}
private lib_struct_member ::= NEWLINE | SEMICOLON | include_statement | macro_control | macro_control_escaped | macro_interpolation | macro_interpolation_escaped | lib_field
lib_union_body ::= lib_union_member* {elementType=lib_body}
private lib_union_member ::= NEWLINE | SEMICOLON | macro_control | macro_control_escaped | macro_interpolation | macro_interpolation_escaped | lib_field

// The compiler treats words such as `next`, `alias`, and `union` as field
// names in C aggregates, and one type declaration may name several fields.
lib_field ::= lib_field_name (COMMA NLS lib_field_name)* COLON type_reference
private lib_field_name ::= IDENTIFIER | keyword_identifier

// External vars take a plain symbol after `=` (compiler IdentOrConst:
// parser.cr:5904-5909 reads the real name as identifier or constant), so
// `lib_external_var` accepts the fun-style symbol rule next to the legacy
// string form. The bare-proc type after `:` stays `type_reference`
// (its ARROW branch already covers `Void* ->`).
lib_external_var ::= GLOBAL_VAR [ASSIGN lib_external_symbol] COLON type_reference

private lib_external_symbol ::= IDENTIFIER | CONSTANT | keyword_identifier | string_expression

// Lib and top-level fun names accept word keywords because the compiler
// keeps them as IDENT tokens (parser.cr IdentOrConst / check_ident);
// operators stay invalid, so keyword_as_method is deliberately not used.
// Newlines never match implicitly here, so a bare `fun` cannot swallow the
// next line's `end` as its name.
private lib_fun_name ::= macro_spliced_name | IDENTIFIER | CONSTANT | keyword_identifier
private top_level_fun_name ::= macro_spliced_name | IDENTIFIER | keyword_identifier

fun_definition ::= FUN lib_fun_name [NLS ASSIGN NLS lib_fun_external_symbol [NLS &(LPAREN | COLON)]] [LPAREN NLS lib_fun_parameter_list NLS RPAREN] [COLON type_reference] {pin=1}

top_level_fun ::= FUN top_level_fun_name [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] method_body END {pin=1}

type_alias_lib ::= ALIAS CONSTANT ASSIGN type_reference

lib_type_alias ::= IDENTIFIER CONSTANT ASSIGN type_reference

lib_struct_definition ::= STRUCT CONSTANT lib_struct_body END

lib_union_definition ::= UNION CONSTANT lib_union_body END

// ==================== Methods ====================

method_definition ::= ABSTRACT DEF method_name [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] [FORALL CONSTANT (COMMA CONSTANT)*]
                    | DEF method_name [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] [FORALL CONSTANT (COMMA CONSTANT)*] method_body END {
  pin(".*")=2
  stubClass="de.magynhard.crystal.stubs.CrystalMethodDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedMethodDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

// PEG longest-match-first: setter definitions (def host=, def self.env=) must be
// tried before plain IDENTIFIER, otherwise the parser consumes only the name and
// strands the '=' (broke stdlib files like uri.cr with `def host=(host : String?)`).
private method_name ::= BACKTICK
              |  IDENTIFIER ASSIGN
              | SELF DOT IDENTIFIER ASSIGN
              // `def {{type.id}}.from_digits(...)` — macro-interpolated receiver
              // (int.cr inside `macro expand_...` for-loops). Must precede the
              // fragment compounds: a committed plain compound would strand the
              // receiver's DOT and fail the whole definition (PEG).
              | macro_interpolation DOT (IDENTIFIER ASSIGN | IDENTIFIER | keyword_as_method | operator_method_name)
               // Compound generated names mix interpolations with literal
               // fragments: `def {{ type.id }}_{{ method.id }}(path)` (kemal
               // filter DSL) and `def to_i{{ n }} : Int{{ n }}` (stdlib big_int,
               // identifier-first). Both directions require at least one
               // interpolation so plain `def foo bar` stays invalid, and both
               // precede the plain forms (PEG longest-match-first). The
               // trailing ASSIGN covers `def {{mapping[0].id}}=(value)`
               // (io_uring.cr), mirroring IDENTIFIER ASSIGN leniency.
               | macro_spliced_name [ASSIGN]
               | IDENTIFIER
               | SELF DOT macro_spliced_name [ASSIGN]
               | SELF DOT (IDENTIFIER | CONSTANT | keyword_as_method | operator_method_name | macro_interpolation)
              // `def Float64.new(...)` — qualified method names inside the type's
              // own scope (float.cr); optional ASSIGN covers `def Float64.round=`.
              | CONSTANT DOT (IDENTIFIER ASSIGN | IDENTIFIER | keyword_as_method | operator_method_name)
              // `def &{{op.id}}(other : {{int2.id}}) : self` — operator-headed
              // generated names inside {% for %} bodies (primitives.cr bitwise
              // ops). Must PRECEDE the bare operator alternative: PEG commits
              // `operator_method_name` alone and strands the interpolation.
              | operator_method_name macro_interpolation (IDENTIFIER | CONSTANT | macro_interpolation)*
               | keyword_as_method
               | operator_method_name

private operator_method_name ::= PLUS | MINUS | STAR | SLASH | PERCENT | AMPERSAND | PIPE | CARET | TILDE
                               | WRAP_PLUS | WRAP_MINUS | WRAP_STAR | WRAP_DOUBLE_STAR
                                | DOUBLE_STAR | LSHIFT | RSHIFT | EQ | NEQ | LT | GT | LTE | GTE
                                | SPACESHIP | CASE_EQ | MATCH_OP | BANG_TILDE
                                | LBRACKET RBRACKET ASSIGN | LBRACKET RBRACKET QUESTION | LBRACKET RBRACKET

method_body ::= statement_list rescue_clause* [else_clause] [ensure_clause]

macro_body ::= macro_body_element*
private macro_body_element ::= MACRO_BODY_CONTENT
                             | MACRO_FRESH_VAR
                             | macro_interpolation
                             | macro_control
                             | NEWLINE
// Leading/trailing NLS: stdlib writes multi-line interpolations
// (Enumerable::Reflect#type spans `{{\n raise(...)\n }}` across lines).
macro_interpolation ::= MACRO_INTERPOLATION_BEGIN NLS expression [postfix_modifier] NLS MACRO_INTERPOLATION_END

// Macro forms in expression positions: `x = {% if %} 1 {% else %} 2 {% end %}`
// (compiler parse_atomic_without_location accepts `{% %}` and `{{ }}` as
// atomic expressions, parser.cr:1015-1024), `when {{ i }}, ...` conditions,
// and `a = {{ expr }}` right-hand sides. Token starts are disjoint from every
// other primary, so no PEG ordering hazard. The structured envelope comes
// first (longest-match): bare tags stay separate members everywhere else.
private macro_content_expression ::= macro_if_envelope | macro_open_control | macro_control_escaped | macro_interpolation | macro_interpolation_escaped

// A lone `{% else %}` / `{% elsif %}` / `{% end %}` tag is never a valid
// expression or argument on its own (stray closers belong to an envelope).
// Gating them out here also stops bare single-token branches from swallowing
// the middle tag as a bare-call argument (`A {% else %}` parsed as call
// `A(else)`, stranding every envelope with a bare branch). Statement and
// member positions keep full macro_control, so `{% if %} ... {% end %}`
// blocks stay flat there.

// Structured `{% if %} A {% else %} B {% end %}` envelopes with expression
// branches: call args (`expect_raises({% if %} A {% else %} B {% end %})`),
// binary operands (`== {% if %} A {% else %} B {% end %} &&`), and named-arg
// values. The open tag must start with IF/UNLESS and at least one ELSE/ELSIF
// branch is mandatory, so plain `{% if %} ... {% end %}` blocks,
// `{% for %}`/`{% begin %}` loops, and assignment branches
// (`PLATFORM = "linux"` is a statement, not an expression) keep parsing as
// separate members. The envelope itself is a real PSI node (not private): an
// argument holding two branch expressions would otherwise flip
// `CrystalArgument.getExpression()` into a list and break every call-site
// consumer. Branches stay real expression nodes inside it.
macro_if_envelope ::= macro_if_open NLS expression (NLS macro_branch_tag NLS expression)+ NLS macro_end_tag
private macro_if_open ::= MACRO_CONTROL_BEGIN (IF | UNLESS) macro_control_token* MACRO_CONTROL_END
private macro_branch_tag ::= MACRO_CONTROL_BEGIN (ELSE | ELSIF) macro_control_token* MACRO_CONTROL_END
private macro_end_tag ::= MACRO_CONTROL_BEGIN END MACRO_CONTROL_END

// Macro-interpolated callee: `def {{method.id}}(path)` plus call forms like
// `{{method.id}} path, form: body` (stdlib http/client.cr generates these inside
// {% for %} loops). Without the bare-argument alternative the tail after the
// interpolation was parsed as a separate bogus statement. The !DOT / !LBRACKET /
// binary-op guards mirror method_call_expression so postfix chains and binary
// expressions after the interpolation still attach through the normal paths.
// The !LBRACE guard: a leading LBRACE after the callee is a BLOCK (bound by the
// trailing [block]) per Crystal semantics, never a hash argument. Braces after a
// comma inside bare arguments remain hash literals (real Crystal: `f 1, {"a" => 1}`
// parses as hash argument).
// Tight (whitespace-free) name fragments concatenate onto a macro expansion:
// `Crystal::{{ type.capitalize }}Def` (ameba's generated visitors). Whitespace-
// separated identifiers stay call arguments (`{{ method.id }} path, form: body`).
private macro_fragment_suffix ::= &<<isTokenTightAfterPreviousToken>> (IDENTIFIER | CONSTANT | macro_interpolation)

private macro_interpolation_call ::= macro_interpolation macro_fragment_suffix* [call_args | !DOT !LBRACKET !LBRACE !binary_op_lookahead !<<isHeredocBodyOpener>> bare_argument_list] [block]

// Macro-spliced generated names: `fun initialize_{{name}}_target`
// (lib_llvm target.cr), alias `LLVMInitialize{{target.id}}Target`, `def
// {{mapping[0].id}}=(value)` (io_uring.cr), `def self.init_{{name}}`
// (llvm.cr), `fun {{...}}(...)` (raise.cr). The compiler parses {% for %}
// bodies as opaque macro text (parse_macro_body), so these names are never
// validated pre-expansion; the rule mirrors method_name's compound
// alternatives. Both directions require at least one interpolation, so
// plain spaced names stay invalid; spaced fragments stay as lenient as the
// existing def compounds.
private macro_spliced_name ::= (IDENTIFIER | CONSTANT) macro_interpolation (IDENTIFIER | CONSTANT | macro_interpolation)*
                             | macro_interpolation (IDENTIFIER | CONSTANT | macro_interpolation)*

macro_control ::= MACRO_CONTROL_BEGIN macro_control_token* MACRO_CONTROL_END
// Expression-position control tags: same soup, but stray closers excluded
// (see macro_content_expression). Aliased to the macro_control element so
// single tags keep their CrystalMacroControl node for every downstream
// consumer (macro-depth counting, require context); only the tag subset
// differs, never the PSI shape.
macro_open_control ::= MACRO_CONTROL_BEGIN !(ELSE | ELSIF | END) macro_control_token* MACRO_CONTROL_END {elementType=macro_control}
// Escaped macro forms: `\{% stmt %}` (primitives.cr:101/146) and `\{{ expr }}`
// — the backslash suppresses the expansion (verbatim data). The lexer pushes
// the ordinary inner states and emits the *_ESCAPED_BEGIN, so the inner token
// set reuses macro_control_token*; the sequence is macro data with no runtime
// value. Valid at the same statement positions as macro_control.
macro_control_escaped ::= MACRO_CONTROL_ESCAPED_BEGIN macro_control_token* MACRO_CONTROL_END
macro_interpolation_escaped ::= MACRO_INTERPOLATION_ESCAPED_BEGIN NLS expression [postfix_modifier] NLS MACRO_INTERPOLATION_END
// CHAR_LITERAL and GLOBAL_VAR must stay in sync with the <MACRO_CONTROL> lexer state,
// which can emit them anywhere inside {% ... %} (e.g. `{% if x == 'a' %}`).
private macro_control_token ::= IDENTIFIER | CONSTANT | INSTANCE_VAR | CLASS_VAR | GLOBAL_VAR | MACRO_FRESH_VAR
    | INTEGER_LITERAL | CHAR_LITERAL | STRING_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN | STRING_INTERPOLATION_END
    | SYMBOL_LITERAL | SYMBOL_COLON
    // Backtick commands and regex literals appear inside macro control blocks:
    // `VERSION = {{ `shards version ...`.stringify }}` (kemal) and
    // `{% elsif prop_stringified =~ /^(Int|Float)\d+$/ %}` (ameba rule_config).
    | COMMAND_BEGIN | COMMAND_LITERAL | COMMAND_END | BACKTICK
    | REGEX_BEGIN | REGEX_LITERAL | REGEX_END
    | TRUE | FALSE | NIL
    | IF | ELSE | ELSIF | END | FOR | IN | UNLESS | WHILE | UNTIL | RESCUE | BEGIN | YIELD | REQUIRE | VERBATIM
    // Declaration keywords appear inside macro control blocks: single-line
    // `{% if %} fun ... {% end %}` (lib_llvm initialization.cr) and generated
    // members. macro_control only consumes tokens without reconstructing PSI,
    // so widening the token set cannot change existing successful parses.
    | DEF | MACRO | FUN | ALIAS | STRUCT | UNION | ENUM | LIB | MODULE | CLASS
    | INCLUDE | EXTEND | ABSTRACT | PRIVATE | PROTECTED
    | LPAREN | RPAREN | LBRACKET | RBRACKET | LBRACE | RBRACE | COMMA | DOT | COLON
    | EQ | NEQ | LT | GT | LTE | GTE | SPACESHIP | MATCH_OP | BANG_TILDE | OR_OR | AND_AND | PIPE | AMPERSAND | CARET | TILDE
    | ASSIGN | PLUS | MINUS | STAR | DOUBLE_STAR | SLASH | DOUBLE_SLASH | DOUBLE_SLASH_ASSIGN | LSHIFT | RSHIFT | QUESTION | BANG | DOTDOT | DOTDOTDOT
    | DOUBLE_COLON | PERCENT
    | NEWLINE | SEMICOLON | HASH | AT | ARROW | DOUBLE_ARROW | ANNOTATION

macro_definition ::= MACRO method_name [LPAREN NLS parameter_list NLS RPAREN] macro_body END {
  pin=1
  stubClass="de.magynhard.crystal.stubs.CrystalMacroDefinitionStub"
  mixin="de.magynhard.crystal.psi.impl.CrystalStubbedMacroDefinitionImpl"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

// ==================== Parameters ====================

parameter_list ::= [parameter_item (COMMA NLS parameter_item)* [COMMA]]
private parameter_item ::= bare_splat_separator | DOTDOTDOT | parameter

// External FFI symbol of a lib fun (`fun iconv = libiconv(...)`,
// `fun realpath = "realpath$DARWIN_EXTSN"(...)`, compiler parse_fun_def).
// Only bare identifiers, constants, and non-interpolated strings qualify —
// never a general expression, so `bar(Int32)` keeps binding as the external
// symbol plus the lib parameter list instead of a call. The string form
// reuses STRING_EXPRESSION PSI without interpolation support, matching the
// compiler's "interpolation not allowed in fun name" rejection.
private lib_fun_external_symbol ::= macro_spliced_name | IDENTIFIER | CONSTANT | keyword_identifier | lib_fun_external_string
lib_fun_external_string ::= (STRING_LITERAL | STRING_ESCAPE)+ {elementType=string_expression}

// Lib fun signatures allow unnamed type-only parameters (`fun strerror_r(Int,
// Char*, SizeT)`, compiler parser.cr `parse_lib_body_exp` unnamed branch).
// The list reuses the PARAMETER_LIST element type so CrystalFunDefinition's
// PSI is unchanged; the type-only item is private so its type children land
// directly in the list without inventing a CrystalParameter. Named items bind
// through `parameter` first, so `status` stays an untyped named parameter
// (still flagged by the lib-fun inspection) while `Int` binds as a type.
// A single union type per item mirrors the compiler — proc commas stay list
// separators, so `Int, Float` remains two parameters.
// Only fun_definition uses this list; def/macro/top-level fun keep the named
// parameter_list, so top-level `fun foo(Int32)` stays a syntax error.
lib_fun_parameter_list ::= [lib_fun_parameter_item (COMMA NLS lib_fun_parameter_item)* [COMMA]] {elementType=parameter_list}
private lib_fun_parameter_item ::= bare_splat_separator | DOTDOTDOT | lib_fun_keyword_parameter | parameter | lib_fun_unnamed_parameter
// C FFI parameters use the compiler's unconstrained IDENT path: a word
// keyword is valid when it has an explicit type, unlike a normal def parameter.
lib_fun_keyword_parameter ::= keyword_identifier COLON type_reference {elementType=parameter}
// Parenthesized proc types carry their output arrow outside the parens
// (`(Bio*, Char*, Int) -> Int`, compiler parse_atomic_type paren branch).
// A bare union never takes an arrow here, so `Int, Float` stays two items.
private lib_fun_unnamed_parameter ::= LPAREN type_reference (COMMA type_reference)* RPAREN ARROW [type_union]
                                    | type_union

// Compiler-verified keyword-as-parameter subset (matches keyword_variable):
// of, union, uninitialized, forall, previous_def. select/alias/end/macro are
// rejected by the compiler even with default or type.
private keyword_parameter_name ::= OF | UNION | UNINITIALIZED | FORALL | PREVIOUS_DEF

private param_prefix ::= annotation_usage
                       | macro_control
// Explicit call-site name plus internal binding/storage target. This longer
// IDENTIFIER-prefixed form must precede the single-name alternative (PEG).
// Any keyword is a valid call-site label (`def pos(location, end end_pos =
// false)` in ameba's source.cr, called as `pos(location, end: true)`;
// `def self.history(with entries = ...)` in reply's spec_helper.cr) — the
// compiler accepts every keyword as the external name as long as a valid
// internal name follows (parser_spec "external names"). The keyword stays a
// token and only this rule accepts it as a label; a lone reserved keyword is
// still rejected — only the keyword_parameter_name subset below stands alone.
// The compiler-verified identifier subset also stands alone as a parameter
// name (`def declare_class_var(node, var, uninitialized)`, `def
// self.map(values, of = nil, &)`, `def parse_c_struct_or_union(union : Bool)`,
// `def self.common_descendent_union(type, union)`) and joins the
// starred/splat name group (`*union`, `&of`).
parameter ::= param_prefix* (IDENTIFIER | keyword_identifier) (IDENTIFIER | instance_var_access | class_var_access) [COLON type_reference] [ASSIGN expression]
            | param_prefix* keyword_parameter_name [COLON type_reference] [ASSIGN expression]
            | param_prefix* AMPERSAND IDENTIFIER COLON type_union COMMA type_union (COMMA type_union)* ARROW [type_reference]
            | param_prefix* [STAR | DOUBLE_STAR | AMPERSAND] (IDENTIFIER | instance_var_access | class_var_access | keyword_parameter_name) [COLON type_reference] [ASSIGN expression]
            | param_prefix* AMPERSAND COLON type_union (COMMA type_union)* ARROW [type_union]
            | param_prefix* AMPERSAND [COLON type_reference]
            | param_prefix* LPAREN IDENTIFIER (COMMA IDENTIFIER)* RPAREN
// Macro-generated splat fragments (`def initialize({{ properties.map do
// |field| ... end.splat }})` in macros.cr `record`, `def {{name.id}}(
// {{operands.splat(", ")}}*, node : ASTNode?)` in the interpreter): the
// fragment expands to whole parameters, so it binds as one CrystalParameter
// whose interpolation child keeps the existing PSI. The splat predicate
// gates admission to fragments ending in `.splat(...)` — bare `{{ x }}`
// stays a syntax error — and the trailing STAR (the named-only marker)
// binds only when tight, exactly as written (`}}*`).
            | param_prefix* macro_interpolation &<<isMacroSplatFragment>> [&<<isTokenTightAfterPreviousToken>> STAR] {
  mixin="de.magynhard.crystal.psi.impl.CrystalParameterMixin"
}
private bare_splat_separator ::= STAR &(COMMA | RPAREN | NEWLINE)

// ==================== Property Declarations ====================

property_declaration ::= (instance_var_access | class_var_access | IDENTIFIER | SELF DOT IDENTIFIER) COLON type_reference [ASSIGN expression]

// ==================== Visibility ====================

// module/enum/annotation/alias: crystal allows `private module SenderReceiverCloseAction`
// inside a class (channel.cr) — without these the parse breaks there and every method
// of the enclosing class drops out of the method-by-class index.
visibility_modifier ::= (PRIVATE | PROTECTED) (method_definition | macro_definition | class_definition | struct_definition | module_definition | enum_definition | annotation_definition | alias_definition | constant_assignment | statement)
                      | (PRIVATE | PROTECTED) SELF DOT IDENTIFIER [call_args | bare_argument_list] [block]
                      | (PRIVATE | PROTECTED) &NEWLINE

// ==================== Statements ====================

statement_list ::= statement_or_separator*

private statement_or_separator ::= NEWLINE | SEMICOLON | statement

statement ::= if_statement
            | unless_statement
            | while_statement
            | until_statement
            | begin_statement
            | for_statement
            | select_statement
            | return_statement
            | break_statement
            | next_statement
            | yield_statement
            | with_yield_statement
            | include_statement
            | extend_statement
            | multi_assignment
            | property_declaration
            | indexed_assignment
            | assignment
            | constant_assignment
            | macro_control
            | macro_control_escaped
            | macro_interpolation_escaped
            | expression_statement

expression_statement ::= expression [expression_assign_suffix [postfix_modifier] | postfix_modifier] [heredoc_bodies]

private expression_assign_suffix ::= assign_op NLS expression

// Postfix modifiers accept assignments as their condition
// (`return [] of T unless t = h[k]?`, `puts x if v = f`), mirroring block-level
// `condition`. The assignment has a dedicated composite so analyses can process
// its write without relying on the surrounding construct's PSI shape.
// Crystal rejects trailing `while` and `until`; those keywords are valid only
// in their dedicated block statement forms.
postfix_modifier ::= (IF | UNLESS | RESCUE) postfix_condition_with_assignment

private postfix_condition_with_assignment ::= postfix_condition_assignment | expression
postfix_condition_assignment ::= variable ASSIGN NLS expression {pin=2
  mixin="de.magynhard.crystal.psi.impl.CrystalConditionAssignmentMixin"
  implements="de.magynhard.crystal.psi.CrystalAssignment"
}

// ==================== Control Flow ====================

if_statement ::= IF condition then_clause statement_list elsif_clause* [else_clause] END {pin=1}

unless_statement ::= UNLESS condition then_clause statement_list [else_clause] END {pin=1}

while_statement ::= WHILE condition then_clause statement_list END {pin=1}

until_statement ::= UNTIL condition then_clause statement_list END {pin=1}

condition ::= condition_assignment | expression
private condition_assignment ::= variable ASSIGN NLS expression

for_statement ::= FOR IDENTIFIER IN expression then_clause statement_list END {pin=1}

case_statement ::= CASE [case_subject] case_clause_trivia ((when_clause | in_clause) case_clause_trivia)+ [else_clause] END {pin=1}

// Macro control around case clauses (`case v; {% for ... %}; when {{...}};
// ...; {% end %}; end` in enum.cr, tuple.cr, token.cr, the interpreter
// sources, tracing.cr, bio.cr): the compiler only ever sees the expanded
// clauses, but this grammar keeps complete `{% ... %}` tags as plain
// CrystalMacroControl leaves, so a case-local trivia rule admits NEWLINE,
// SEMICOLON, and macro_control before the first clause and between clauses.
// At least one real when/in clause is still required (empty cases and
// when/in mixing stay separate gaps), and a `{% end %}` tag can never stand
// in for the runtime END — macro_control consumes its own END plus `%}`.
private case_clause_trivia ::= (NEWLINE | SEMICOLON | macro_control)*

// Case subject: Crystal allows assignments as case subjects (`case v = yield e`,
// `case x, y = pair`). Assignments are statements in this grammar, not expressions,
// so they need an explicit alternative here. PEG longest-match-first: assignment
// forms MUST be tried before expression, otherwise `case v = expr` matches the
// subject as just `v` and strands the `=` (case_statement is pinned at CASE, so
// the failed attempt cannot retry with a different subject parse).
private case_subject ::= multi_assignment | assignment | constant_assignment | expression

begin_statement ::= BEGIN statement_list rescue_clause* [else_clause] [ensure_clause] END {pin=1}

select_statement ::= SELECT NEWLINE+ select_when_clause+ [else_clause] END

select_when_clause ::= WHEN statement then_clause statement_list

private then_clause ::= THEN | NEWLINE | SEMICOLON

elsif_clause ::= ELSIF condition then_clause statement_list

else_clause ::= ELSE statement_list

when_clause ::= WHEN when_entry_list then_clause statement_list

// Crystal case/when supports implicit-subject comparisons: `when .< 0`, `when .>= 1`.
// Tried before plain expressions because the bare implicit call would otherwise
// consume just the operator and strand the comparison operand. Scoped to when-clauses —
// this syntax is invalid anywhere else in Crystal.
// NOTE: deliberately does NOT reference expression_list — a shared child element type
// makes GrammarKit emit duplicate accessors on CrystalWhenClause.
// Case when-entries accept assignments that bind the matched value:
// `when path = find_as_path(globs)`, `when guard_clause = guard_clause(node)`
// (ameba) — mirroring case_subject's assignment forms. Assignments must be
// tried before plain expressions so `when x = expr` binds the whole entry.
private when_entry_list ::= implicit_when_comparison (macro_argument_trivia COMMA macro_argument_trivia implicit_when_comparison)*
                           | when_condition_entry (macro_argument_trivia COMMA macro_argument_trivia when_condition_entry)* [COMMA macro_argument_trivia]

private when_condition_entry ::= multi_assignment | assignment | expression

private implicit_when_comparison ::= DOT operator_method_name NLS expression

in_clause ::= IN expression_list [IF condition] then_clause statement_list

rescue_clause ::= RESCUE [rescue_spec] then_clause statement_list

// rescue_spec: handles all Crystal rescue clause forms.
// Order matters in PEG (longer alternative first for IDENTIFIER disambiguation).
// type_reference supports unions (SomeError | OtherError) and namespaces (::Foo).
private rescue_spec ::= IDENTIFIER COLON type_reference
                       | IDENTIFIER
                       | type_reference [rescue_macro_tail]

// `rescue IO::Error{% unless %} | OpenSSL::SSL::Error{% end %}` (http
// server.cr, valid inside `{% begin %}` macro bodies): macro tags attach
// tightly to the type, so the first tag must directly abut it — a newline
// before `{%` keeps the plain spec and the block parses separately.
private rescue_macro_tail ::= &<<isTokenTightAfterPreviousToken>> macro_control [PIPE type_reference] macro_control

ensure_clause ::= ENSURE statement_list

return_statement ::= RETURN postfix_modifier
                   | RETURN abrupt_value_list [postfix_modifier] [heredoc_bodies]
                   | RETURN {pin=1
  implements="de.magynhard.crystal.psi.CrystalAbruptStatement"
}

break_statement ::= BREAK postfix_modifier
                  | BREAK abrupt_value_list [postfix_modifier] [heredoc_bodies]
                  | BREAK {pin=1
  implements="de.magynhard.crystal.psi.CrystalAbruptStatement"
}

next_statement ::= NEXT postfix_modifier
                 | NEXT abrupt_value_list [postfix_modifier] [heredoc_bodies]
                 | NEXT {pin=1
  implements="de.magynhard.crystal.psi.CrystalAbruptStatement"
}

private abrupt_value_list ::= abrupt_value (COMMA NLS abrupt_value)*
private abrupt_value ::= nested_assignment | expression
nested_assignment ::= variable assign_op NLS (nested_assignment | nested_indexed_assignment | expression) {pin=2
  mixin="de.magynhard.crystal.psi.impl.CrystalNestedAssignmentMixin"
  implements="de.magynhard.crystal.psi.CrystalAssignment"
}

// Assignment RHS may itself be an indexed compound assignment:
// `calls = @scope_call_queue[@current_scope] ||= [] of Crystal::Call` (ameba).
// No postfix modifier in nested position — the outer assignment owns it.
// Public (composite) so its children do not inline into assignment/nested_assignment:
// an inlined repeated argument_list/ivar child flips the single accessors of
// CrystalAssignment into lists (GrammarKit @NotNull inference).
nested_indexed_assignment ::= indexed_assignment_target (LBRACKET indexed_assignment_index RBRACKET)+ assign_op NLS (indexed_assignment | nested_assignment | expression)

yield_statement ::= YIELD [LPAREN argument_list RPAREN | bare_argument_list] [postfix_modifier] {pin=1}
// Yield in expression position may pass multiple values (`memo = found ? (yield memo, elem) : elem`).
// PEG longest-match-first: the single-expression form is tried BEFORE the parenthesized
// argument list, so `yield (a) + b` still parses as one argument expression; when a
// comma appears inside the parentheses the grouped_expression alternative fails and
// the argument_list form takes over (`yield (memo, elem)` = two values).
yield_expression ::= YIELD yield_expression_args {pin=1}

// Leading expression is optional so bare `return yield` / assignment RHS `x = yield`
// parse; comma-list mirrors yield_statement's multi-value form.
private yield_expression_args ::= [yield_leading_argument] (COMMA NLS expression)*
                                | LPAREN argument_list RPAREN

// The leading bare yield argument must not start with `if` or `unless`
// (`return yield unless ready`, markd timer): those open a control-flow
// statement that would swallow the enclosing method's `end` as its own body
// terminator, while the trailing modifier belongs to the outer abrupt
// statement or assignment as a postfix modifier (Crystal parses
// `yield if true` as `If(Yield)`). Parenthesized statement arguments keep
// working through the argument_list alternative (`yield(if ready then 1 end)`).
// Only `if`/`unless` are ambiguous: they are the expression-starting postfix
// modifier keywords, so no other leading token can be misread this way.
private yield_leading_argument ::= !IF !UNLESS expression

// `with scope yield value` is an expression (including multi-assignment and
// block bodies), not only a standalone statement. The existing element type
// keeps statement-position PSI stable while primary-expression alternatives
// below admit the same construct where the compiler does.
with_yield_statement ::= WITH expression YIELD [LPAREN argument_list RPAREN | bare_argument_list] {pin=1}

// ==================== Assignments ====================

assignment ::= variable assign_op NLS (assignment | nested_indexed_assignment | expression) [postfix_modifier] [heredoc_bodies] {pin=2
  mixin="de.magynhard.crystal.psi.impl.CrystalAssignmentMixin"
}

// Indexed assignment targets: `chars[index] = carry = 'a'`, `@data[i] = x`.
// The receiver may itself be a dot chain (`crystal.types[name] = ...` in
// program.cr) and the right-hand side may chain further indexed assignments
// (`buffer_ptr[8] = buffer_ptr[13] = 70` in uuid.cr, `ENV["FOO"] =
// ENV["BAR"] = "1"`); the index may hold an assignment (`str[i += 1] = ...`
// in base64.cr). All three are compiler-valid. The wrappers stay private so
// existing trees keep their shape: plain targets still attach the same
// leaves, and reads without a trailing assign operator still fall through
// to plain expressions (no pin, as before).
// NOTE: no pin here — `match[group]?` must be able to fall through to a plain
// expression when no assignment operator follows the brackets.
indexed_assignment ::= indexed_assignment_target (LBRACKET indexed_assignment_index RBRACKET)+ assign_op NLS (indexed_assignment | nested_assignment | expression) [postfix_modifier]

private indexed_assignment_target ::= assignment_target dot_call_access*

private indexed_assignment_index ::= assignment | argument_list

// Indexed assignment targets also accept constant receivers:
// `ENV["GITHUB_STEP_SUMMARY"] = ...` (ameba specs) and `self[i] = value`
// (pointer.cr swap) — brackets are required by indexed_assignment, so plain
// constants keep binding through constant_assignment and bare `self = value`
// never parses as assignment (assignment itself starts with `variable`).
private assignment_target ::= SELF
                            | variable
                            | instance_var_access | class_var_access
                            | [DOUBLE_COLON] CONSTANT (DOUBLE_COLON CONSTANT)*

// Postfix modifiers apply to multi-assignments exactly like plain assignments
// (`u, v = v, u if u > v` in int.cr's gcd) — without it the trailing `if`
// opens an if_statement that swallows the enclosing method's `end`.
// Pinned at the ASSIGN (element 5), not at the target list: before the `=`
// the prefix may still be a plain comma-separated expression list
// (`when transitions.empty?, unix_seconds < ...` in time/tz.cr) — only the
// `=` commits the assignment shape. Member targets made the prefix greedier
// (`transitions.empty?,`), so pinning any earlier strands the expression-list
// fallback behind the pin.
multi_assignment ::= multi_assign_target COMMA NLS multi_assign_target_list ASSIGN NLS multi_assign_values [postfix_modifier] {pin=5}
private multi_assign_target_list ::= multi_assign_target (COMMA NLS multi_assign_target)*
multi_assign_target ::= STAR (multi_assign_indexed_target | multi_assign_member_target | variable | UNDERSCORE)
                       | multi_assign_indexed_target
                       | multi_assign_member_target
                       | variable [COLON type_reference]
                       | UNDERSCORE
                       | LPAREN multi_assign_target COMMA multi_assign_target_list RPAREN
// Setter-shaped member targets: `@editor.width, @editor.height = ...`
// (reply reader.cr), `a.foo, a.bar = 1, 2`, `a.b.c, d = 1, 2`
// (compiler parser_spec). At least one argument-free dot access on a
// variable or constant receiver; calls with arguments, parentheses, or
// blocks stay rejected exactly like the compiler (verified: `a.foo()` and
// `a.@x` fail, while `a.foo?`, `Foo.bar`, and `a.Foo` parse as targets).
// The indexed-target and member alternatives precede the plain variable
// form so PEG does not commit the receiver alone and strand the access
// (`a.value[n]`, `self[0]`, `self.current_pos`).
private multi_assign_indexed_target ::= indexed_assignment_target (LBRACKET indexed_assignment_index RBRACKET)+
private multi_assign_member_target ::= multi_assign_member_root (DOT multi_assign_member_name)+
private multi_assign_member_root ::= SELF | variable | CONSTANT
private multi_assign_member_name ::= IDENTIFIER | CONSTANT | keyword_as_method
private multi_assign_values ::= expression (COMMA expression)*

constant_assignment ::= CONSTANT ASSIGN NLS expression [postfix_modifier] [heredoc_bodies] {
  pin=2
}

// Macro fresh variables: `%value` and `%var{key.id}` between macro control
// tags (`{% begin %}` bodies in iterator.cr, json/from_yaml.cr) and in macro
// bodies (MACRO_BODY lexes the fresh var as a bare token; the optional key
// appears only where real braces are tokenized). The name token is the whole
// composite's leaf; the key expression is macro data resolved at expansion
// time, so name-based consumers see the token `%value`.
macro_fresh_variable ::= MACRO_FRESH_VAR [LBRACE expression RBRACE] {
  mixin="de.magynhard.crystal.psi.impl.CrystalMacroFreshVariableMixin"
}

// Word keywords are valid local-variable names, exactly the subset the
// compiler accepts as identifiers: `union = alloca llvm_type(type)` (codegen
// call.cr), `if of = node.of` (literal_expander.cr), `store @last, union`.
// `out` is excluded: a leading `out` is its own argument-forwarding keyword
// (`out x`), so `out = v` stays invalid; `end`/`def`/... stay reserved so the
// def-body terminator and statement starts never rebind as expressions.
private keyword_variable ::= OF | UNION | UNINITIALIZED | FORALL | PREVIOUS_DEF
// Rvalue subset: UNINITIALIZED must never start a plain reference — the
// `uninitialized T` type-expression alternative owns the token there
// (`t = uninitialized U`, class.cr), so the rvalue set drops it.
private keyword_variable_value ::= OF | UNION | FORALL | PREVIOUS_DEF

private variable ::= instance_var_access | class_var_access | GLOBAL_VAR | IDENTIFIER
                       | keyword_variable
                       | macro_fresh_variable

private assign_op ::= ASSIGN | PLUS_ASSIGN | MINUS_ASSIGN | STAR_ASSIGN | SLASH_ASSIGN
                     | PERCENT_ASSIGN | AMPERSAND_ASSIGN | PIPE_ASSIGN | CARET_ASSIGN
                     | DOUBLE_STAR_ASSIGN | DOUBLE_SLASH_ASSIGN | LSHIFT_ASSIGN | RSHIFT_ASSIGN
                     | OR_OR_ASSIGN | AND_AND_ASSIGN
                     | WRAP_PLUS_ASSIGN | WRAP_MINUS_ASSIGN | WRAP_STAR_ASSIGN | WRAP_DOUBLE_STAR_ASSIGN

private compound_assign_op ::= PLUS_ASSIGN | MINUS_ASSIGN | STAR_ASSIGN | SLASH_ASSIGN
                              | PERCENT_ASSIGN | AMPERSAND_ASSIGN | PIPE_ASSIGN | CARET_ASSIGN
                              | DOUBLE_STAR_ASSIGN | DOUBLE_SLASH_ASSIGN | LSHIFT_ASSIGN | RSHIFT_ASSIGN
                              | OR_OR_ASSIGN | AND_AND_ASSIGN
                              | WRAP_PLUS_ASSIGN | WRAP_MINUS_ASSIGN | WRAP_STAR_ASSIGN | WRAP_DOUBLE_STAR_ASSIGN

// ==================== Expressions ====================

expression ::= or_expression [QUESTION [expression COLON expression]]

private or_expression ::= and_expression (OR_OR NLS and_expression)*

// Prefix `!` binds tight like every other unary operator: the compiler parses
// it in parse_prefix with parse_prefix as its operand (parser.cr:631-648), so
// `!!signature.block != yields` (method_lookup.cr:197),
// `!!double_splat != !!other.double_splat` (restrictions.cr:527), and
// `yields == !!block` (suggestions.cr:50) each evaluate a NOT of a prefix
// chain, then compare. The former `not_expression` level sat above
// comparison, so `yields != !!block` failed outright and a leading
// `!a == b` bound the whole comparison under NOT — both wrong per the
// compiler (`!a == b` is `(!a) == b`, verified against crystal 1.21).
// The level is gone; the and/or rows reference comparison directly.
private and_expression ::= comparison_expression (AND_AND NLS comparison_expression)*

private comparison_expression ::= range_expression ((EQ | NEQ | LT | GT | LTE | GTE | SPACESHIP | CASE_EQ | MATCH_OP | BANG_TILDE) NLS range_expression)*

private range_expression ::= (DOTDOT | DOTDOTDOT) NLS [or_bitwise_expression]
                           | or_bitwise_expression [(DOTDOT | DOTDOTDOT) NLS [or_bitwise_expression]]

private or_bitwise_expression ::= xor_expression (PIPE NLS xor_expression)*

private xor_expression ::= and_bitwise_expression (CARET NLS and_bitwise_expression)*

private and_bitwise_expression ::= shift_expression (AMPERSAND NLS shift_expression)*

private shift_expression ::= additive_expression ((LSHIFT | RSHIFT) NLS additive_expression)*

private additive_expression ::= multiplicative_expression ((PLUS | MINUS | WRAP_PLUS | WRAP_MINUS) NLS multiplicative_expression)*

private multiplicative_expression ::= power_expression ((STAR | SLASH | DOUBLE_SLASH | PERCENT | WRAP_STAR) NLS power_expression)*

private power_expression ::= unary_expression ((DOUBLE_STAR | WRAP_DOUBLE_STAR) NLS unary_expression)*

// Unary wrapping operators: `&+`/`&-` are prefix operators just like `+`/`-`
// (`value = &-boundary` in pointer.cr, `value < 0 ? &-v : v` in big_int.cr;
// compiler parse_prefix, parser_spec.cr:294/295). `&*` and `&**` stay binary
// and as compound operators — the compiler rejects `value = &*operand` — and
// the token starts are disjoint from the existing unary set, so no PEG hazard.
private unary_expression ::= (PLUS | MINUS | TILDE | AMPERSAND | STAR | CARET | WRAP_PLUS | WRAP_MINUS | BANG) unary_expression
                            | postfix_expression

private postfix_expression ::= primary_expression postfix_op*

// `.!` pseudo-method suffix (Not): `foo.!`, `foo.!()`, and the guard-shorthand
// chains `&.dst?.!` (location_spec.cr), `&.empty?.!` (colorize.cr),
// `&.has_any_args?.!` (semantic new.cr). It is not a definable method name —
// the compiler rejects `def !` (parser_spec "cannot define a not method") — so
// it deliberately stays a private token-level suffix outside
// dot_call_access/keyword_as_method: no CrystalDotCallAccess, no reference,
// exactly like the compiler's Not pseudo-call. The bare `.!` alternative
// carries a `!LPAREN` guard: only immediately-empty `!()` qualifies; content
// inside the parens (`value.!(args)`) is a compiler syntax error and must not
// fall through to a call-args postfix of the chain.
private bang_suffix ::= NLS DOT BANG !LPAREN
                      | NLS DOT BANG LPAREN NLS RPAREN

private postfix_op ::= NLS DOT (AS | AS_QUESTION | IS_A) LPAREN type_reference RPAREN
                     | NLS bang_suffix
                     // PEG: member assignment must precede ordinary dot-call access, otherwise
                     // `config.server ||= value` commits to `.server` and strands the assign op.
                     // Plain ASSIGN covers setter calls as nested assignment values
                     // (`x = node.exp.visibility = node.modifier`, ameba scope_visitor);
                     // top-level setter statements keep binding through the statement suffix.
                     | NLS DOT IDENTIFIER (compound_assign_op | ASSIGN) expression
                     | NLS dot_call_access [block]
                     // Nil-question chain on non-identifier receivers (`$1?.presence`,
                     // ameba admonition): tight only, so the spaced ternary `a ? b : c`
                     // keeps binding at the expression level.
                     | &<<isTokenTightAfterPreviousToken>> QUESTION
                     | namespace_access
                     | LBRACKET argument_list RBRACKET [&<<isTokenTightAfterPreviousToken>> QUESTION]
                     // Empty tight brackets after an expression are an EMPTY-ARGUMENT
                     // call (`Int64[]` invokes the Number `[]` macro with zero args,
                     // number_spec.cr:398), never an array literal — the array-literal
                     // path would strand a standalone CrystalArrayLiteral and trigger
                     // the "Empty array literal requires type" false positive. Tight
                     // only: spaced `f []` stays a call with an empty array argument.
                     | &<<isTokenTightAfterPreviousToken>> LBRACKET RBRACKET
                     | call_args [block]

// DOT-call access: the method-name + optional args part of a DOT-call (e.g. `.tanzen`,
// `.new(arg)`, `.method arg`). Non-private so it gets a real PSI composite with a
// CrystalDotCallAccessMixin providing getReference() — enables identifier highlighting
// and hover for DOT-calls (Apfel.tanzen, a.essen) through the same PsiReference
// mechanism as variable_reference. The DOT and method name are children of this composite;
// the receiver is the prevSibling in the flattened postfix_expression sequence.
// INSTANCE_VAR/CLASS_VAR after DOT: Crystal allows accessing another object's
// ivars within the same class (`other.@length` in String#==).
// The bare-argument alternative needs !DOT and !LBRACKET (same guards as
// method_call_expression): without them, a bracket access binds as an Array-literal
// argument (config(["envs"])) and a following chained dot expression binds as
// arguments of the dot-call itself (cpu_count[.to_i, debug : Bool = ...]).
// !LBRACE: `{` directly after the method name starts a BLOCK (consumed by the
// trailing [block]), never a hash argument — real Crystal parses `obj.m { }` as an
// empty block; only braces after a comma (`f 1, {…}`) are hash literals.
// The bare-argument alternative needs !DOT !LBRACKET !LBRACE guards: without
// them, obj.name["key"] binds the bracket access as an Array-LITERAL argument
// of the dot-call instead of the index postfix — silently producing
// config(["envs"]) — and `obj.m { }` would bind a block as a bare argument.
// The third alternative covers bare MACRO invocations with a leading array
// argument followed by more arguments (`Number.expand_div [Int8, UInt8],
// Float64` in int.cr/float.cr): array_literal already carries its own
// brackets, and the required COMMA after it distinguishes the argument form
// from the index postfix (config["envs"] has no comma and keeps binding as
// index).
dot_call_access ::= DOT (IDENTIFIER | CONSTANT | INSTANCE_VAR | CLASS_VAR | keyword_as_method | macro_interpolation) [&<<isTokenTightAfterPreviousToken>> QUESTION]
                           [!<<isTokenTightAfterPreviousToken>> call_args COMMA bare_argument_list
                           | call_args
                           // The lookahead mirrors method_call_expression's bare
                           // alternative with Crystal's unary-operator whitespace rule:
                           // `Time.monotonic - start` is the spaced binary minus, never a
                           // bare argument of the dot-call, while the tight minus in
                           // `file.seek -ZIP_TAIL_SIZE` stays the unary negation of the
                           // first argument (stdlib time.cr `shift -span.to_i`).
                           | !DOT !LBRACKET !LBRACE !<<isDotBareArgsBinaryOp>> !<<isHeredocBodyOpener>> bare_argument_list
                           // Loose (whitespace-separated) bare array argument with
                           // no comma: `CLI.parse_args [\n ... \n]` (ameba cmd_spec)
                           // is a call with the array as its only argument, never an
                           // index postfix. The looseness predicate replaces the
                           // !LBRACKET veto: a tight `[` (`config.foo["key"]`) still
                           // binds as the index postfix. !LBRACE keeps `obj.m { }` on
                           // the block path; the binary/range ops (`obj.m ..5` — Crystal
                           // rejects a leading `..` here) stay blocked.
                           | !DOT !LBRACE !<<isDotBareArgsBinaryOp>> !<<isTokenTightAfterPreviousToken>> !<<isHeredocBodyOpener>> bare_argument_list
                           // Array-comma bare arguments (`obj.f [1], 2`) are a
                           // whitespace-separated form: a tight `[` directly after
                           // the method name is the receiver's INDEX postfix
                           // (`identity.headers["Etag"], "gzip"` as another call's
                           // argument — kemal static_file_handler_spec:135) and
                           // must never swallow the enclosing call's next argument.
                           | !<<isTokenTightAfterPreviousToken>> array_literal COMMA bare_argument_list] {
  mixin="de.magynhard.crystal.psi.impl.CrystalDotCallAccessMixin"
}

// Namespace access: `::Const` in expression context (e.g. `Foo::Bar`, `::Foo`, `A::B::C`).
// Non-private so it gets a real PSI composite with a CrystalNamespaceAccessMixin providing
// getReference() — enables Go to Definition and hover for intermediate namespace segments
// (e.g. `Bar` in `Foo::Bar.baz`). The DOUBLE_COLON and CONSTANT are children of this
// composite; the preceding part of the namespace path is the prevSibling in the flattened
// postfix_expression sequence.
// Macro-interpolated segments after the separator: `Crystal::{{ name }}` and
// `Crystal::{{ type.capitalize }}Def` (ameba's generated visitors) concatenate
// macro expansions into the qualified path.
namespace_access ::= DOUBLE_COLON (CONSTANT | macro_interpolation) macro_fragment_suffix* {
  mixin="de.magynhard.crystal.psi.impl.CrystalNamespaceAccessMixin"
}

// Keywords that Crystal allows as method names after DOT
private keyword_as_method ::= keyword_identifier
                             | PLUS | MINUS | STAR | SLASH | PERCENT | DOUBLE_STAR
                             | EQ | NEQ | BANG_TILDE | LT | GT | LTE | GTE | SPACESHIP
                            | LSHIFT | RSHIFT | AMPERSAND | PIPE | CARET | TILDE
                            | DOUBLE_SLASH

// Crystal accepts word keywords as named argument labels (`for: time`) and as
// names passed to declaration macros (`property next : Fiber?`). Operators are
// valid method names but not argument labels, so keep this set separate.
private keyword_identifier ::= ABSTRACT | ALIAS | ANNOTATION | AS | AS_QUESTION | ASM
                             | BEGIN | BREAK
                             | CASE | CLASS
                             | DEF | DO
                             | ELSE | ELSIF | END | ENSURE | ENUM | EXTEND
                             | FALSE | FOR | FORALL | FUN
                             | IF | IN | INCLUDE | INSTANCE_SIZEOF | IS_A
                             | LIB
                             | MACRO | MODULE
                             | NEXT | NIL | NIL_QUESTION
                             | OF | OFFSETOF | OUT
                             | POINTEROF | PREVIOUS_DEF | PRIVATE | PROTECTED
                             | REQUIRE | RESCUE | RESPONDS_TO | RETURN
                             | SELECT | SELF | SIZEOF | STRUCT | SUPER
                             | THEN | TRUE | TYPEOF
                             | UNINITIALIZED | UNION | UNLESS | UNTIL
                             | VERBATIM
                             | WHEN | WHILE | WITH
                             | YIELD

// ==================== Primary Expressions ====================

// Expression-positioned control flow: Crystal allows early exits anywhere an
// expression is expected (`self[x || return nil]?`, `cond && break`). Statement
// positions keep their dedicated return/break/next statements — this alternative
// only engages when RETURN/BREAK/NEXT appears mid-expression.
private control_flow_expression ::= RETURN [abrupt_value_list]
                                   | BREAK [abrupt_value_list]
                                   | NEXT [abrupt_value_list]

private primary_expression ::= grouped_expression
                             | control_flow_expression
                             | with_yield_statement
                             | array_literal
                             | hash_literal
                             | typed_collection_literal
                             | tuple_literal
                             | proc_literal
                             | require_statement
                             | namespace_access
                             | method_call_expression
                             | implicit_object_call
                             | literal
                             | instance_var_access
                             | class_var_access
                             | variable_reference
                             | macro_fresh_variable
                             | typeof_expression
                             | sizeof_expression
                             | instance_sizeof_expression
                              | pointerof_expression
                             | offsetof_expression
                                   | uninitialized_expression
                                   | asm_expression
                                   | macro_interpolation_call
                              | macro_content_expression
                               | yield_expression
                              | if_statement
                              | unless_statement
                              | while_statement
                              | until_statement
                              | case_statement
                             | begin_statement
                             | SELF

// Crystal parenthesized expressions carry postfix modifiers inside the group:
// `test(a, (ifs if ifs.size > 1))` (ameba) — the modifier belongs to the group
// value, while `(x) if cond` keeps the modifier outside (PEG: the `)` ends the
// group before the modifier can bind inside).
grouped_expression ::= LPAREN NLS expression [assign_op NLS expression] [postfix_modifier] NLS RPAREN

// Global-scope method calls: ::raise "msg", ::puts x, ::Foo::Bar.baz. The [DOUBLE_COLON]
// prefix calls the method in the top-level namespace, ignoring any current scope.
// namespace_access (DOUBLE_COLON CONSTANT) is tried first in primary_expression, so
// ::Constant without arguments still resolves as namespace access; only ::ident(args)
// and bare ::ident fall through to this rule. Without it, ::raise inside a do-block
// breaks the block parse, backtracks the whole postfix chain, and collapses every
// subsequent statement into error recovery (see Enumerable#indexable cascade).
// The !LBRACE guard on the bare-argument alternative: `{` directly after the callee
// starts a BLOCK (bound by the trailing [block] or the block-only alternatives below),
// never a hash argument — real Crystal parses `Thread.new { }` as an empty block and
// even errors on `f {"a" => 1}`; braces after a comma (`f 1, {…}`) stay hash literals.
// `record Name, field : Type do ... end` is a macro call whose body is parsed
// as a type body: unlike an ordinary runtime block it may contain definitions.
// Keep it a method_call_expression so existing record constructor resolution,
// completion, navigation, and inspections continue to consume its arguments.
method_call_expression ::= &<<isRecordDeclaration>> IDENTIFIER (call_args | bare_argument_list) DO class_body END
                         | [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT) !<<isTokenTightAfterPreviousToken>> call_args COMMA bare_argument_list [block]
                         | [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT) call_args [block]
                         // The lookahead uses Crystal's unary-operator whitespace rule:
                         // `shift -span.to_i, -span.nanoseconds` (time.cr) negates its
                         // first bare argument; a spaced binary operator still blocks the
                         // bare-argument alternative so `width + height` stays binary.
                         | [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT) !DOT !LBRACKET !LBRACE !<<isDotBareArgsBinaryOp>> bare_argument_list [block]
                         // Tight-`[` is the index postfix (see dot_call_access), never
                         // the receiver's own array argument.
                         | [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT) !<<isTokenTightAfterPreviousToken>> array_literal COMMA bare_argument_list [block]
                         // Loose (whitespace-separated) bare array argument with no
                        // comma: `parse_args [\n ... \n]` is a call with the array as
                        // its only argument; the looseness predicate keeps a tight
                        // `[` (`foo["key"]`) on the index postfix path.
                         | [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT) !DOT !LBRACE !<<isDotBareArgsBinaryOp>> !<<isTokenTightAfterPreviousToken>> !<<isHeredocBodyOpener>> bare_argument_list [block]
                          | [DOUBLE_COLON] (IDENTIFIER | CONSTANT) block
                          | (IDENTIFIER | CONSTANT) block
                          // Block-only super/previous_def (`super { |i| yield i }`
                          // in range.cr, slice.cr): the compiler routes super
                          // through the normal call path and always parses a
                          // block afterwards (parser.cr parse_var_or_call plus
                          // parse_block), so no arguments are required. Token
                          // starts are disjoint from the call_args branch.
                          | (SUPER | PREVIOUS_DEF) block
                          | (SUPER | PREVIOUS_DEF) call_args [block]
                         // !DOT: `super.tap do` chains through the postfix rules — a
                         // bare argument must not swallow the chained member access,
                         // otherwise the trailing block strands. The remaining guards
                         // mirror method_call_expression's bare alternative.
                         | (SUPER | PREVIOUS_DEF) !DOT !LBRACKET !LBRACE !binary_op_lookahead bare_argument_list [block] {
  mixin="de.magynhard.crystal.psi.impl.CrystalMethodCallExpressionMixin"
}

// Prevent bare_argument_list from consuming binary operators followed by expression-starting
// tokens as bare unary expressions. Without this, "width + height" is parsed as method call
// "width(+height)" instead of the binary expression "width + height".
// Also blocks *, /, % etc. so that "x * scalar" inside parenthesized calls is not
// misparsed as bare method call "x" with arguments "* scalar".
// Covers all expression-starting tokens: identifiers, constants, literals, vars, group/array/hash
// literals, percent literals, heredocs, commands, regex, and macro interpolation.
// Tradeoff: bare calls with splat like "add *args" need parentheses: "add(*args)".
private binary_op_lookahead ::= (PLUS | MINUS | STAR | SLASH | DOUBLE_SLASH | PERCENT | DOUBLE_STAR)
    (IDENTIFIER | CONSTANT | STRING_LITERAL | INTEGER_LITERAL | FLOAT_LITERAL | CHAR_LITERAL
     | SYMBOL_LITERAL | NIL | TRUE | FALSE | SELF | SUPER | PREVIOUS_DEF
     | INSTANCE_VAR | CLASS_VAR | GLOBAL_VAR
     | REQUIRE
     | LPAREN | LBRACKET | LBRACE
     | PERCENT_LITERAL_BEGIN | PERCENT_SYMBOL_BEGIN
     | HEREDOC_START | COMMAND_BEGIN | REGEX_BEGIN | MACRO_INTERPOLATION_BEGIN)

// Same guard for NESTED bare calls (see bare_method_call_expression), additionally
// blocking range operators unconditionally: inside an argument list an identifier
// directly followed by ".." / "..." always continues a Range (`consume first..,
// other`, `consume first..n`) — never a nested call.
private nested_call_lookahead ::= binary_op_lookahead | (DOTDOT | DOTDOTDOT)

// Implicit object call: .method, .method(args), or .[index] (used in &.foo shorthand and case/when patterns)
// AS/AS_QUESTION are needed for the &. shorthand without receiver (`to_a(&.as(T))`):
// the postfix_op .as(...) form only applies after an existing primary expression.
implicit_object_call ::= DOT (IDENTIFIER | keyword_as_method | INSTANCE_VAR | CLASS_VAR | RESPONDS_TO | IS_A | NIL_QUESTION | AS | AS_QUESTION | macro_interpolation | operator_method_name) [&<<isTokenTightAfterPreviousToken>> QUESTION]
                           [call_args [block] | !DOT !LBRACKET !LBRACE !<<isHeredocBodyOpener>> bare_argument_list [block] | !<<isTokenTightAfterPreviousToken>> array_literal COMMA bare_argument_list | block]
                       | DOT LBRACKET argument_list RBRACKET [&<<isTokenTightAfterPreviousToken>> QUESTION] [assign_op expression]
                       // Pseudo-method `.!` shorthand (`find(&.!)`); same !LPAREN
                       // strictness as bang_suffix.
                       | DOT BANG !LPAREN
                       | DOT BANG LPAREN NLS RPAREN

// Third alternative group — closeless heredoc calls (`f(rule, <<-CRYSTAL)`): the
// lexer folds the ')' and any further same-line code after the delimiter into a
// SECOND HEREDOC_START absorbed inside the heredoc literal, so such argument
// Heredoc-call arguments are plain argument_list entries: each heredoc header
// is a MARKER argument (HEREDOC_START token, see lexer), and the matching
// string bodies are attached at statement level via [heredoc_bodies].
// Parenthesized heredoc calls keep their bodies INSIDE call_args: the body
// opener token is the newline after the header line, so the sequence
// [ARGUMENT_LIST][bodies][RPAREN] tiles contiguously. Bare (paren-less) calls
// attach bodies at statement level instead.
call_args ::= LPAREN NLS argument_list heredoc_bodies? NLS RPAREN
            | LPAREN RPAREN

argument_list ::= call_argument (macro_argument_trivia COMMA call_argument)* [macro_argument_trivia COMMA] macro_argument_trivia
                | macro_only_argument_list

// Envelope before trivia-split arguments (PEG longest-match-first): the
// envelope carries newlines-only leading trivia so it always sees its
// `{% if %}` open tag — full macro_argument_trivia would eat the tag and
// strand the branches, and IntelliJ's PEG does not re-split greedily eaten
// trivia after a later failure. The fallback keeps full trivia, so lone
// `{% if %} X {% end %}` controls flow through plain arguments exactly as
// before.
private call_argument ::= NLS macro_if_envelope | macro_argument_trivia argument

private macro_argument_trivia ::= (NEWLINE | macro_control)*
private macro_only_argument_list ::= NEWLINE* macro_control (NEWLINE | macro_control)*

argument ::= STAR expression
           | DOUBLE_STAR expression
           | AMPERSAND expression
           | out_argument
           | named_type_argument
           | named_argument
           | starred_type_expression
           | expression
           {
  mixin="de.magynhard.crystal.psi.impl.CrystalAccessorArgumentMixin"
}

// C pointer suffixes inside generic type arguments used as call arguments:
// `Pointer(UInt8*)`, `Pointer(LibC::SizeT)`-style receivers in stdlib code
// (string.cr#encode). A trailing STAR has no expression meaning (binary *
// requires a right operand), so this alternative fails fast on every regular
// argument and can never shadow normal calls.
private starred_type_expression ::= type_path (STAR | DOUBLE_STAR)+

// Call arguments are whitespace-sensitive in Crystal: `name: value` is a named
// expression, while `name : Type` is a type-shaped declaration-macro argument.
// Whitespace tokens are skipped by PsiBuilder, so non-consuming external
// predicates inspect skipped source text before COLON for horizontal whitespace
// or an escaped newline. Keeping the two forms disjoint avoids PEG prefix commits
// and preserves multiline multiplications such as `x: CONST *\n 3`.
private compact_colon ::= !<<colonHasLeadingDeclarationWhitespace>> COLON
private spaced_colon ::= &<<colonHasLeadingDeclarationWhitespace>> COLON

private named_argument ::= (IDENTIFIER | keyword_identifier | string_label) compact_colon NLS (control_value | expression) {pin=2}

// TYPE-shaped parenthesized argument: `foo(x : Int32*)`,
// `foo(x : Int32* | Nil)`, and multiline forms. Tried before named_argument;
// spaced_colon makes the alternatives disjoint rather than heuristic.
private named_type_argument ::= (IDENTIFIER | keyword_identifier) spaced_colon NLS type_reference [named_type_default] {pin=2}

// Crystal `out` accepts a local (including `_`) or an instance variable and
// allows a newline after the keyword. Keep this rule unpinned so `out: value`
// can fall through to the keyword-named argument alternative above.
private out_argument ::= OUT NLS (IDENTIFIER | INSTANCE_VAR)

// Bare (parenthesis-free) arguments — used for calls like: describe App5 do ... end
// Trivia only AROUND commas (never leading/trailing): multi-line bare calls like
// stdlib `record ToUnsignedInfo(T),\n  value : T,\n  ...` need newline tolerance
// between entries, while statement boundaries after an untrailing bare call must
// keep their NEWLINE unconsumed.
bare_argument_list ::= bare_argument (macro_argument_trivia COMMA macro_argument_trivia bare_argument)* [COMMA macro_argument_trivia]

bare_argument ::= named_type_bare_argument
                | named_bare_argument
                | STAR bare_expression
                | DOUBLE_STAR bare_expression
                | AMPERSAND bare_expression
                | assignment
                | bare_expression
                | out_argument
                {
  mixin="de.magynhard.crystal.psi.impl.CrystalAccessorArgumentMixin"
}

// Control expressions are valid argument VALUES: `skip: if skip.is_a?(Category)`
// (ameba's elseif_aware_node_visitor). Positional bare arguments keep excluding
// them — `f x if cond` is a postfix modifier on the call, never an argument.
private control_value ::= if_statement | unless_statement | out_argument

private named_bare_argument ::= (IDENTIFIER | keyword_identifier | string_label) compact_colon NLS
    (control_value | absolute_namespace_bare_expression [ASSIGN bare_expression] | bare_expression [ASSIGN bare_expression]) {pin=2}

// String keys for named arguments (`with_env("FOO": "bar")`,
// `NamedTuple("a-b": String)`): plain literal leaves, exactly like the lib
// fun external symbol — the compiler rejects interpolated labels, and the
// shared call-argument helpers unquote the leaves into the label. Only the
// compact (whitespace-free) colon qualifies; spaced forms stay with the
// type-position rules or fail like before.
private string_label ::= (STRING_LITERAL | STRING_ESCAPE)+

// Keep the absolute start bounded to compact named values: making it a global
// bare-postfix alternative changes namespace-call PSI and resolution. The
// regular expression grammar provides the complete operator precedence once
// the unique DOUBLE_COLON start has selected this branch.
private absolute_namespace_bare_expression ::= &DOUBLE_COLON expression

// TYPE-shaped macro argument: proc types in property/getter macro calls like
// `property upgrade_handler : (IO ->)?` (stdlib http/server/response.cr) or
// `(->) | Nil` (spec/example.cr), pointer types, static arrays of pointers, and
// pointer-to-proc types. spaced_colon keeps it disjoint from named expressions,
// so it can precede named_bare_argument without shadowing regular calls.
private named_type_bare_argument ::= (IDENTIFIER | keyword_identifier) spaced_colon type_reference [named_type_default] {pin=2}

// Wrapped so the optional default stays inside a private rule: GrammarKit's
// @NotNull inference flips unrelated element accessors (CrystalTupleLiteral,
// CrystalAsmOperand) when expression rules appear directly in an optional position.
private named_type_default ::= ASSIGN (assignment | expression)

// Bare expression: same as expression but does not consume blocks or assignments
// This prevents the bare argument from eating the 'do' that belongs to the outer method call
private bare_expression ::= bare_or_expression [QUESTION [expression COLON expression]]

private bare_or_expression ::= bare_and_expression (OR_OR NLS bare_and_expression)*

private bare_and_expression ::= bare_comparison_expression (AND_AND NLS bare_comparison_expression)*

private bare_comparison_expression ::= bare_range_expression ((EQ | NEQ | LT | GT | LTE | GTE | SPACESHIP | CASE_EQ | MATCH_OP | BANG_TILDE) NLS bare_range_expression)*

private bare_range_expression ::= (DOTDOT | DOTDOTDOT) NLS [bare_or_bitwise_expression]
                               | bare_or_bitwise_expression [(DOTDOT | DOTDOTDOT) NLS [bare_or_bitwise_expression]]

private bare_or_bitwise_expression ::= bare_xor_expression (PIPE NLS bare_xor_expression)*

private bare_xor_expression ::= bare_and_bitwise_expression (CARET NLS bare_and_bitwise_expression)*

private bare_and_bitwise_expression ::= bare_shift_expression (AMPERSAND NLS bare_shift_expression)*

private bare_shift_expression ::= bare_additive_expression ((LSHIFT | RSHIFT) NLS bare_additive_expression)*

private bare_additive_expression ::= bare_multiplicative_expression ((PLUS | MINUS | WRAP_PLUS | WRAP_MINUS) NLS bare_multiplicative_expression)*

private bare_multiplicative_expression ::= bare_power_expression ((STAR | SLASH | DOUBLE_SLASH | PERCENT | WRAP_STAR) NLS bare_power_expression)*

private bare_power_expression ::= bare_unary_expression ((DOUBLE_STAR | WRAP_DOUBLE_STAR) NLS bare_unary_expression)*

private bare_unary_expression ::= (PLUS | MINUS | TILDE | AMPERSAND | STAR | WRAP_PLUS | WRAP_MINUS | BANG) bare_unary_expression
                                | bare_postfix_expression

private bare_postfix_expression ::= bare_primary_expression bare_postfix_op*

private bare_postfix_op ::= NLS DOT (AS | AS_QUESTION | IS_A) LPAREN type_reference RPAREN
                           | NLS bang_suffix
                           | NLS dot_call_access
                          | namespace_access
                          | LBRACKET argument_list RBRACKET [&<<isTokenTightAfterPreviousToken>> QUESTION]
                          // Empty tight brackets after a bare expression are an
                          // empty-argument call (`Int64[]`), not an array literal.
                          | &<<isTokenTightAfterPreviousToken>> LBRACKET RBRACKET
                          | call_args

// Bare primary: like primary but no blocks or method calls with bare args (to prevent ambiguity)
private bare_primary_expression ::= grouped_expression
                                  | control_flow_expression
                                  | with_yield_statement
                                  | array_literal
                                  | hash_literal
                                  | typed_collection_literal
                                  | tuple_literal
                                  | proc_literal
                                  | require_statement
                                  | bare_method_call_expression
                                  | implicit_object_call
                                  | macro_interpolation_call
                                  | literal
                                  | instance_var_access
                                  | class_var_access
                                  | variable_reference
                                  | macro_fresh_variable
                                  | typeof_expression
                                  | sizeof_expression
                                  | instance_sizeof_expression
                                  | pointerof_expression
                                  | offsetof_expression
                                  | uninitialized_expression
                                  | asm_expression
                                  | macro_interpolation_call
                                  // After the interpolation-call form (PEG longest-match-first):
                                  // the bare `{{method.id}}` callee must keep binding its
                                  // arguments through macro_interpolation_call.
                                  | macro_content_expression
                                  | SELF

// Bare calls nest inside argument lists exactly like Crystal: `exec new_request method,
// path` parses as exec(new_request(method, path)) — the inner call consumes the whole
// comma-separated tail. Without the second alternative the tail was split off into a
// bogus multi-assignment statement (broke stdlib http/client.cr). The guards mirror
// method_call_expression: no member access, no index, and no binary-operator lookahead,
// so `width + height` stays a binary expression instead of becoming call arguments.
bare_method_call_expression ::= (IDENTIFIER | CONSTANT) call_args
                              // !isDotBareArgsBinaryOp refines the old !nested_call_lookahead
                              // with Crystal's unary whitespace rule: `shift -span.to_i,
                              // -span.nanoseconds` (time.cr) negates its first bare argument,
                              // while a spaced `+`/`-`/`*` still starts a binary expression.
                              | (IDENTIFIER | CONSTANT) !DOT !LBRACKET !<<isDotBareArgsBinaryOp>> !DOTDOT !DOTDOTDOT !<<isHeredocBodyOpener>> bare_argument_list
                              | (IDENTIFIER | CONSTANT) !<<isTokenTightAfterPreviousToken>> array_literal COMMA bare_argument_list
                              // Loose (whitespace-separated) bare array argument with
                              // no comma (`parse_args [\n ... \n]`); the tight `[`
                              // stays on the index postfix path.
                              | (IDENTIFIER | CONSTANT) !DOT !LBRACE !<<isDotBareArgsBinaryOp>> !DOTDOT !DOTDOTDOT !<<isTokenTightAfterPreviousToken>> !<<isHeredocBodyOpener>> bare_argument_list {
  mixin="de.magynhard.crystal.psi.impl.CrystalBareMethodCallExpressionMixin"
}

// Empty bodies are valid Crystal: `Thread.new { }`, `spawn { }`, `f do end`.
// The statement_list is optional in both alternatives.
block ::= DO [PIPE NLS parameter_list NLS PIPE] [statement_list] rescue_clause* [else_clause] [ensure_clause] END
        | LBRACE [PIPE NLS parameter_list NLS PIPE] [statement_list] RBRACE

// Proc/Lambda literal: ->{ body }, ->(params) { body }, ->method_name(types)
// Proc pointers also take instance/class-variable receivers (`->@worker.run`,
// `->@@worker.run(Int32)` — scheduler.cr:257); the compiler requires a dot
// plus method name after the variable (parse_fun_pointer, parser.cr:2073-2088),
// so the variable alternative keeps its DOT mandatory while the plain
// identifier/constant form stays as-is. Raw leaves match the existing
// token-based pointer branch: no new PSI element, no stub change.
proc_literal ::= ARROW LPAREN NLS parameter_list NLS RPAREN LBRACE statement_list RBRACE
               | ARROW LPAREN NLS parameter_list NLS RPAREN DO [statement_list] END
               | ARROW LBRACE statement_list RBRACE
               | ARROW (INSTANCE_VAR | CLASS_VAR) DOT (IDENTIFIER | CONSTANT) [LPAREN type_reference (COMMA type_reference)* RPAREN]
               | ARROW (IDENTIFIER | CONSTANT) [DOT (IDENTIFIER | CONSTANT)] [LPAREN type_reference (COMMA type_reference)* RPAREN] {pin=1}

// ==================== Literals ====================

private literal ::= INTEGER_LITERAL
                  | FLOAT_LITERAL
                  | CHAR_LITERAL
                  | string_expression
                  | symbol_string_expression
                  | SYMBOL_LITERAL
                  | regex_expression
                  | command_expression
                  | NIL
                  | TRUE
                  | FALSE
                  | SELF
                  | SUPER
                  | PREVIOUS_DEF
                  | heredoc_marker
                  | percent_literal

private interpolation_expression ::= STRING_INTERPOLATION_BEGIN expression [postfix_modifier] STRING_INTERPOLATION_END

// Double-quoted string content: plain chunks, escapes, and inlined
// interpolations. The expression is a PsiLanguageInjectionHost
// (CrystalStringExpressionMixin) so `# language=<id>` comments can inject an
// embedded language into the string content (between the quotes).
string_expression ::= (STRING_LITERAL | STRING_ESCAPE | interpolation_expression)+ {
  mixin="de.magynhard.crystal.psi.impl.CrystalStringExpressionMixin"
  implements="com.intellij.psi.PsiLanguageInjectionHost"
}
regex_expression ::= REGEX_BEGIN (REGEX_LITERAL | STRING_ESCAPE | interpolation_expression)* REGEX_END
command_expression ::= COMMAND_BEGIN (COMMAND_LITERAL | STRING_ESCAPE | interpolation_expression)* COMMAND_END

// Heredoc STRING BODY: opener token + content lines + terminator. Bodies are
// attached to the statement owning the call whose argument list contained the
// matching header MARKER (see heredoc_marker), one body per marker in order.
// The literal is a PsiLanguageInjectionHost (CrystalHeredocLiteralMixin) so
// embedded-language injectors (<<-SQL, <<-JAVASCRIPT, ...) can target it.
heredoc_literal ::= HEREDOC_START (HEREDOC_CONTENT | STRING_ESCAPE | interpolation_expression)* [HEREDOC_END] {
  mixin="de.magynhard.crystal.psi.impl.CrystalHeredocLiteralMixin"
  implements="com.intellij.psi.PsiLanguageInjectionHost"
}

// Header MARKER inside argument lists: consumes only the delimiter token; the
// string body follows after the call (see heredoc_bodies).
private heredoc_marker ::= HEREDOC_START

// String bodies for heredoc headers used as call arguments: bound after the
// owning call's statement. Marker N-th (argument order) pairs with body N-th.
heredoc_bodies ::= heredoc_literal+

// Word arrays (%w/%W) get their own BEGIN/END pair so type inference can
// distinguish Array(String) from plain %q/%Q strings sharing PERCENT_LITERAL_*.
percent_literal ::= PERCENT_LITERAL_BEGIN percent_literal_content* PERCENT_LITERAL_END
                  | PERCENT_WORD_ARRAY_BEGIN percent_literal_content* PERCENT_WORD_ARRAY_END
                  | PERCENT_SYMBOL_BEGIN percent_symbol_content* PERCENT_SYMBOL_END
private percent_literal_content ::= STRING_LITERAL | STRING_ESCAPE | interpolation_expression | SYMBOL_LITERAL | REGEX_LITERAL | COMMAND_LITERAL | NEWLINE
// %I interpolates symbol words, so its content mirrors the interpolation support of %W.
private percent_symbol_content ::= SYMBOL_LITERAL | interpolation_expression | NEWLINE

// Macro-generated symbol: `:{{name.id}}` (colorize.cr fore/back,
// `getter :{{property.id}}` macros.cr, `attributes[:{{var.name.id}}]?`).
// No space after the colon (compiler expects an identifier token there),
// reusing the symbol_string_expression element type so type inference and
// receiver trust treat it exactly like `:"name"`.
symbol_string_expression ::= SYMBOL_COLON (STRING_LITERAL | STRING_ESCAPE | interpolation_expression)+
                            | COLON &<<isTokenTightAfterPreviousToken>> macro_interpolation

array_literal ::= LBRACKET NLS [expression_list] NLS RBRACKET [OF type_reference]

hash_literal ::= LBRACE NLS [hash_entry_list] NLS RBRACE [OF type_reference DOUBLE_ARROW type_reference]

// Crystal literal instantiation: `HTTP::Headers{...}` (kemal request specs) —
// a constant type path directly followed by a brace literal instantiates a
// typed hash or tuple/array (`Set{"a", "b"}`, `Deque{1, 2}`). Hash entries
// are tried first so `Type{"key" => value}` preserves its existing shape.
// Registered before method_call_expression/bare calls so CONSTANT + LBRACE
// binds the literal instead of a block call.
private typed_collection_literal ::= type_path LBRACE NLS [hash_entry_list | expression_list] NLS RBRACE

hash_entry_list ::= hash_entry (NLS COMMA NLS hash_entry)* [COMMA]

hash_entry ::= expression (DOUBLE_ARROW | COLON) expression

// ==================== Variable References ====================

// Macro-generated instance variables inside {% for %}-driven method bodies:
// `@{{ method.id }}` and the compound `@{{ method.id }}_parsed` memoization
// flags (kemal param_parser). The generated access carries no name element, so
// name-based consumers see null exactly like other macro-generated members.
instance_var_access ::= INSTANCE_VAR
                      | AT macro_interpolation [IDENTIFIER] {
  mixin="de.magynhard.crystal.psi.impl.CrystalInstanceVarAccessMixin"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

class_var_access ::= CLASS_VAR {
  mixin="de.magynhard.crystal.psi.impl.CrystalClassVarAccessMixin"
  implements="de.magynhard.crystal.psi.CrystalNamedElement"
}

// The same compiler-verified keyword subset rebinds as a variable reference in
// expression/rvalue position: `store @last, union`, `[of.key, of.value]`,
// `if of = node.of`. Statement-reserved keywords stay rejected.
// A lone `uninitialized` may be a keyword-named local parameter/value
// (`TypeDeclarationWithLocation.new(..., uninitialized, nil)`). If the next
// token starts a type, the existing `uninitialized_expression` owns it instead.
private uninitialized_variable_reference ::= UNINITIALIZED !type_reference

variable_reference ::= GLOBAL_VAR | IDENTIFIER | CONSTANT | keyword_variable_value | uninitialized_variable_reference {
  mixin="de.magynhard.crystal.psi.impl.CrystalVariableReferenceMixin"
}

// ==================== Type References ====================

// Crystal proc-type sugar: `A, B -> C` is `Proc(A, B, C)` (kemal's router
// aliases, block parameters typed `T1, T2 ->`). The comma list is only valid
// when an ARROW follows, so parameter lists (`x : Int32, y : Int32`) fail the
// first alternative cleanly and fall through to the plain union form.
type_reference ::= type_union (COMMA NLS type_union)* ARROW [type_union]
                 | type_union [ARROW [type_union]]
                 | ARROW [type_union]

// Deliberately permissive across newlines: crystal rejects multi-line unions
// without a trailing backslash ("expecting token 'CONST', not 'NEWLINE'"), but
// flagging that here would pin GrammarKit's generic error marker to the rescue
// keyword. CrystalUnionContinuationAnnotator reports it precisely on the dangling
// pipe with a compiler-style message and an add-backslash quick fix.
// The lexer turns `\` + newline into whitespace, so continued unions parse transparently.
private type_union ::= type_single (PIPE NLS type_single)*

private type_single ::= STAR type_path [type_arguments] [QUESTION]
                       | type_atom type_suffix*

private type_atom ::= type_path [type_arguments]
                        // `num : {{type.id}} = 0` — macro-interpolated types appear in
                        // macro-generated method bodies (int.cr from_digits).
                       | macro_interpolation
                       | SELF
                       | TYPEOF LPAREN NLS typeof_argument_list NLS RPAREN
                       | LPAREN type_reference (COMMA type_reference)* RPAREN
                       | LBRACE NLS IDENTIFIER COLON type_reference (NLS COMMA NLS IDENTIFIER COLON type_reference)* NLS RBRACE
                       | LBRACE NLS type_reference (NLS COMMA NLS type_reference)* NLS RBRACE
                       | IDENTIFIER

private type_suffix ::= QUESTION
                      | STAR
                      | DOUBLE_STAR
                      | LBRACKET (INTEGER_LITERAL | type_path) RBRACKET
                      | DOT CLASS

// Type paths with macro-interpolated segments: `Crystal::{{ name }}` (ameba's
// generated visitors) and `Int{{ n.id }}` (stdlib big_int generated returns).
// A segment is a constant optionally followed by an interpolation, or a bare
// interpolation.
type_path ::= [DOUBLE_COLON] type_path_piece (DOUBLE_COLON type_path_piece)* {
  mixin="de.magynhard.crystal.psi.impl.CrystalTypePathMixin"
}

private type_path_piece ::= CONSTANT macro_interpolation?
                          | macro_interpolation

type_arguments ::= LPAREN NLS type_argument (NLS COMMA NLS type_argument)* [NLS COMMA] NLS RPAREN

private type_argument ::= type_reference | INTEGER_LITERAL

type_parameters ::= LPAREN NLS type_parameter_item (COMMA NLS type_parameter_item)* [COMMA] NLS RPAREN
private type_parameter_item ::= [STAR] CONSTANT [ASSIGN type_reference]

// ==================== Type Names ====================

private type_name ::= CONSTANT (DOUBLE_COLON CONSTANT)*
                    // `struct {{num.id}}` / `class {{name.id}} < View` —
                    // macro-generated type names inside {% for %} bodies
                    // (primitives.cr, compiler_rt.cr, log/format.cr,
                    // io/byte_format.cr). Precedes nothing sensitive: PEG only
                    // reaches the interpolation when no CONSTANT starts the name.
                    | macro_interpolation

// ==================== Typeof / Sizeof ====================

// The compiler's parse_typeof accepts one or more expressions, with newlines
// after the opener or comma and an optional trailing comma:
// `typeof(t, u)`, `typeof(\n t,\n u,\n)`. Keep the comma directly after an
// expression so `typeof(t\n, u)` remains invalid like the compiler.
private typeof_argument_list ::= expression (COMMA NLS expression)* [COMMA]

typeof_expression ::= TYPEOF LPAREN NLS typeof_argument_list NLS RPAREN {pin=1}

sizeof_expression ::= SIZEOF LPAREN NLS type_reference NLS RPAREN {pin=1}

instance_sizeof_expression ::= INSTANCE_SIZEOF LPAREN NLS type_reference NLS RPAREN {pin=1}

pointerof_expression ::= POINTEROF LPAREN NLS pointerof_target NLS RPAREN {pin=1}

// `pointerof` targets: the compiler parses a full assignment-level expression
// (parse_pointerof, parser.cr:6069) but only accepts variables, constants, and
// read-instance-variables semantically (pointerof_var, main_visitor.cr:2687).
// The qualified alternative therefore admits exactly chains that end in
// `.@ivar` (`fiber.@context`, `buf.value.@privileges`), reusing the existing
// dot_call_access PSI. Ordinary calls, index access, literals, and `self`
// stay rejected; so does `foo.@bar.baz` (an ivar may not appear mid-chain).
// Lib-external-var targets (`pointerof(LibFFI.ffi_type_void)`) are a separate
// family: syntactically indistinguishable from ordinary calls, they need a
// semantic approach, not a wider rule here.
// PEG: the qualified form precedes the plain forms, otherwise `fiber` wins
// first-match and strands the dot. The `*` repetition is possessive, so the
// lookaheads keep intermediate links (non-ivar names) disjoint from the
// terminal `.@ivar` — a bare `dot_call_access*` would swallow the terminal.
private pointerof_target ::= pointerof_qualified_instance_var
                           | instance_var_access
                           | class_var_access
                           | variable_reference

private pointerof_qualified_instance_var ::= (instance_var_access | class_var_access | variable_reference) pointerof_receiver_access* pointerof_terminal_ivar_access

private pointerof_receiver_access ::= &(NLS DOT (IDENTIFIER | CONSTANT | keyword_as_method | macro_interpolation)) NLS dot_call_access

private pointerof_terminal_ivar_access ::= &(NLS DOT INSTANCE_VAR) NLS dot_call_access

offsetof_expression ::= OFFSETOF LPAREN NLS type_reference COMMA NLS instance_var_access NLS RPAREN {pin=1}

uninitialized_expression ::= UNINITIALIZED type_reference {pin=1}

asm_expression ::= ASM LPAREN NLS string_expression NLS [asm_sections] NLS RPAREN {pin=1}

// ASM sections: up to 4 colon-separated sections (outputs, inputs, clobbers, options)
// DOUBLE_COLON (::) counts as two consecutive colons (skipping a section)
private asm_sections ::= DOUBLE_COLON NLS COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]
                       | DOUBLE_COLON NLS [asm_operand_list] [NLS COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]]
                       | COLON NLS [asm_operand_list] NLS DOUBLE_COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]
                       | COLON NLS [asm_operand_list] [NLS COLON NLS [asm_operand_list] [NLS COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]]]

private asm_operand_list ::= asm_operand (NLS COMMA NLS asm_operand)*

asm_operand ::= string_expression LPAREN expression RPAREN

private asm_clobber_list ::= string_expression (NLS COMMA NLS string_expression)*

private asm_option_list ::= string_expression (NLS COMMA NLS string_expression)*

// ==================== Expression Lists ====================

// Trivia between/after entries tolerates macro_control: the stdlib builds tuples
// via {% for %} loops (Enumerable#zip yields
// `{elem, {% for %} other_elem{{i}}, {% end %}}`). Deliberately NO mandatory
// trailing trivia here — when/in clause terminators rely on consuming their own
// terminating NEWLINE. Trailing macro directives are handled at use sites
// (see tuple_literal).
expression_list ::= macro_argument_trivia expression (macro_argument_trivia COMMA macro_argument_trivia expression)* [COMMA macro_argument_trivia]

// Macro-controlled tuples: stdlib builds them via {% for %} loops. The extra
// trailing trivia absorbs directives after the last entry without forcing
// expression_list itself to consume terminator newlines needed by when-clauses.
// Heredoc markers as tuple entries bind their string bodies inside the braces:
// `.should eq({<<-PRE.lines, <<-POST.lines` + bodies + `})` (ameba util_spec).
tuple_literal ::= LBRACE NLS expression_list [heredoc_bodies] macro_argument_trivia NLS RBRACE

// ==================== Helper Rules ====================

private NLS ::= NEWLINE*
